{
  "crons": [
    {
      "path": "/api/cron/send-scheduled",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/sync",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/deploy-digest",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/cleanup-ai-replies",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/check-reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/migrate",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "30 3 * * *"
    }
  ]
}
